# Inventario canónico de variables de TiendaKatEye.
# Copia este archivo a .env y reemplaza los valores marcados como REEMPLAZA_*.
# No versionar .env.

MYSQL_DATABASE=kateye
MYSQL_USER=kateye
SPRING_DATASOURCE_PASSWORD=REEMPLAZA_CON_TU_PASSWORD
MYSQL_ROOT_PASSWORD=REEMPLAZA_CON_TU_ROOT_PASSWORD
JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_LARGO
CORS_ORIGEN=http://localhost:5173
KATEYE_PAGO_SIMULADO_RESULTADO=APROBADA
BACKEND_PORT=8080
KATEYE_PEDIDO_EXPIRACION_MINUTOS=30
KATEYE_PEDIDO_ZONA_HORARIA=America/Santiago

# El override docker-compose.rechazo.yml fuerza KATEYE_PAGO_SIMULADO_RESULTADO=RECHAZADA.
